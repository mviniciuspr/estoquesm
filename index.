<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>San Marino - Controle de Estoque </title>
    <style>
        body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f7f9; margin: 0; padding: 20px; }
        .container { max-width: 1100px; margin: auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
        header { border-bottom: 2px solid #eee; margin-bottom: 25px; padding-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        h1 { color: #004085; margin: 0; font-size: 24px; }
        .filtros { background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; gap: 15px; border: 1px solid #dee2e6; }
        select { padding: 10px; border-radius: 6px; border: 1px solid #ced4da; font-size: 16px; min-width: 200px; cursor: pointer; background: white; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th { background: #f8f9fa; color: #333; padding: 15px; text-align: left; font-size: 13px; border-bottom: 2px solid #dee2e6; letter-spacing: 1px; }
        td { padding: 15px; border-bottom: 1px solid #eee; color: #333; font-size: 15px; background: white; }
        tr:hover td { background: #fcfcfc; }
        .badge-dias { color: #dc3545; font-weight: 800; font-size: 16px; }
        .placa-texto { font-weight: 700; color: #212529; font-size: 16px; }
        .loja-tag { font-weight: 800; color: #004085; text-transform: uppercase; font-size: 12px; }
    </style>
</head>
<body>

<div class="container">
    <header>
        
        <div id="resumo" style="color: #666; font-weight: bold;"></div>
    </header>

    <div class="filtros">
        <strong>Selecione a Unidade:</strong>
        <select id="filtro" onchange="renderizar()">
            <option value="Todas">TODAS AS LOJAS</option>
            <option value="Matriz">MATRIZ</option>
            <option value="Multimarcas">MULTIMARCAS</option>
            <option value="Zona Sul">ZONA SUL</option>
            <option value="Viamão">VIAMÃO</option>
            <option value="Gravataí">GRAVATAÍ</option>
        </select>
    </div>

    <table>
        <thead>
            <tr>
                <th>LOJA</th>
                <th>MODELO DO VEÍCULO</th>
                <th>PLACA</th>
                <th>DIAS SEM FOTO</th>
            </tr>
        </thead>
        <tbody id="tabelaCorpo"></tbody>
    </table>
</div>

<script>
/**
 * ATUALIZAÇÃO: Cole os dados entre as crases abaixo. 
 */
const dadosBrutos = `
Matriz	Cronos 1.0 Drive	SDW3H63	28
Multimarcas	Renegade 1.8 Sport	JAR9E81	23
Matriz	ONIX 1.4 MPFI LTZ 8V FLEX 4P MANUAL	IYG-5636	15
Matriz	Cronos Drive 1.3	JCU7E41	14
Matriz	Mobi 1.0 Trekking	JCZ8F30	9
Matriz	Onix Turbo 1.0 LT	JBF2I85	9
Matriz	Cronos 1.3 Drive	JCR2J49	8
Matriz	ARGO 1.0 FIREFLY FLEX DRIVE MANUAL	JBN0F14	3
`;

function limparEProcessar() {
    const linhas = dadosBrutos.trim().split('\n');
    const unidades = ["Matriz", "Multimarcas", "Zona Sul", "Viamão", "Gravataí"];
    
    return linhas.map(linha => {
        let partes = linha.split(/\t| {2,}/).map(p => p.trim()).filter(p => p !== "");

        if (partes.length < 3) {
            for (let u of unidades) {
                if (linha.startsWith(u)) {
                    let resto = linha.substring(u.length).trim();
                    let match = resto.match(/(.*)\s+([A-Z0-9-]{6,8})\s+(\d+)$/);
                    if (match) {
                        return { loja: u, modelo: match[1].trim(), placa: match[2], dias: match[3] };
                    }
                }
            }
        }

        if (partes.length >= 4) {
            return { loja: partes[0], modelo: partes[1], placa: partes[2], dias: partes[3] };
        } else if (partes.length === 3) {
            return { loja: partes[0], modelo: partes[1], placa: "---", dias: partes[2] };
        }
        return null;
    }).filter(item => item !== null);
}

const listaFinal = limparEProcessar();

function renderizar() {
    const filtro = document.getElementById('filtro').value;
    const corpo = document.getElementById('tabelaCorpo');
    const resumo = document.getElementById('resumo');
    
    corpo.innerHTML = "";
    let cont = 0;

    listaFinal.forEach(c => {
        if (filtro === "Todas" || c.loja.toLowerCase() === filtro.toLowerCase()) {
            cont++;
            corpo.innerHTML += `
                <tr>
                    <td class="loja-tag">${c.loja}</td>
                    <td>${c.modelo}</td>
                    <td class="placa-texto">${c.placa}</td>
                    <td class="badge-dias">${c.dias} dias</td>
                </tr>
            `;
        }
    });

    resumo.innerText = `Total: ${cont} veículos`;
}

renderizar();
</script>

</body>
</html>
